CodeSystem: CSRehabAssessment
Id: rehab-assessment-codes
Title: "Rehabilitation assessment item codes"
Description: "Local codes for BRS-A and upper-extremity manual muscle test questionnaire items used for observation extraction."
* ^url = "https://kimsber.github.io/Rehab-IG/CodeSystem/rehab-assessment-codes"
* ^caseSensitive = true
* ^content = #complete
* ^experimental = false

* #brs-a-proximal-upper-extremity "BRS-A proximal upper extremity stage"
* #brs-a-distal-upper-extremity "BRS-A distal upper extremity stage"
* #mmt-shoulder-abduction "Shoulder abduction manual muscle test grade"
* #mmt-shoulder-adduction "Shoulder adduction manual muscle test grade"
* #mmt-elbow-flexion "Elbow flexion manual muscle test grade"
* #mmt-elbow-extension "Elbow extension manual muscle test grade"
* #mmt-wrist-flexion "Wrist flexion manual muscle test grade"
* #mmt-wrist-extension "Wrist extension manual muscle test grade"
* #mmt-finger-flexion "Finger flexion manual muscle test grade"
* #mmt-finger-extension "Finger extension manual muscle test grade"
